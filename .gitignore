# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# Turborepo cache
.turbo/
**/.turbo/

# Testing & Coverage
coverage/
**/coverage/

# Environment files
.env
.env*.local
.env.development
.env.test
**/.env*.local
!env.example
!**/env.example
!.env.production
!**/.env.production

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo

# Vercel
.vercel
**/.vercel

# OS & Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
